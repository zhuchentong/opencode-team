{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["jsdoc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "overrides": [
    {
      // JSDoc 风格检测：全仓源码（server、shared、tui 均已铺 JSDoc）。
      // TS 项目惯例：签名已表达类型，故不启用 *-type 类规则，只查结构完整性与描述缺失。
      "files": ["server/**", "shared/**", "tui/**"],
      "rules": {
        "jsdoc/require-param": "warn",
        "jsdoc/require-param-description": "warn",
        "jsdoc/require-returns": "warn",
        "jsdoc/require-returns-description": "warn",
        "jsdoc/empty-tags": "warn",
        "jsdoc/no-blank-blocks": "warn",
        "jsdoc/check-tag-names": "warn"
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "dist/", ".workflow/", "p0-probe/"]
}
